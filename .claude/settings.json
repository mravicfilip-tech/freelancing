{
  "claudeMdExcludes": [
    "**/.claude/studio/AGREEMENT.md",
    "**/.claude/studio/DOCTRINE.md",
    "**/.claude/studio/foundation/writing.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/studio/hooks/guard.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/studio/hooks/guard.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/studio/hooks/secrets.mjs\"", "timeout": 5 }
        ]
      }
    ]
  }
}
