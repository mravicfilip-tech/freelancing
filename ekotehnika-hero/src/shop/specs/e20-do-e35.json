 "lede": "Električni viljuškar, nosivosti 2.500 do 3.500 kg, u 10 verzija.",
 "characteristics": [
  {
   "group": "Zaštita od eksplozije",
   "icon": "shield",
   "bullets": [
    "Sertifikacija i dokumentacija prema ATEX 2014 / 34 / EU i važećim EU normama obezbeđuju usklađenost sa propisima",
    "Sertifikacija celog viljuškara za zonu 1 / 21, a ne samo pojedinačnih električnih sklopova, obezbeđuje najviši nivo bezbednosti",
    "Pasivni koncept zaštite omogućava viljuškarima za zonu 2 / 22 rad u eksplozivnoj atmosferi, bez potrebe za gašenjem",
    "Zaštita električne opreme i zaštita od mehanički izazvanih varnica, neprihvatljivo visokih temperatura i opasnih elektrostatičkih naelektrisanja"
   ]
  },
  {
   "group": "Upravljanje",
   "icon": "lever",
   "bullets": [
    "Potpuno integrisane mere zaštite od eksplozije čuvaju odličnu preglednost i prostranost kabine vozača",
    "Pogon na prednje točkove sa dva motora zajedno sa kombinovanom upravljačkom osovinom daje izuzetnu upravljivost",
    "Gornji cilindar za naginjanje i stub otporan na uvijanje obezbeđuju bezbedno rukovanje teretom",
    "Sinhroni reluktantni motor za podizanje i vožnju povećava snagu i energetsku efikasnost",
    "Bežični pristup podacima o vozaču omogućava analizu podataka i povezivanje sa logističkim sistemima, sistemima bezbednosti i sistemima za upravljanje voznim parkom"
   ]
  },
  {
   "group": "Bezbednost",
   "icon": "shield",
   "bullets": [
    "Stalno praćenje bezbednosnih vrednosti važnih za ATEX",
    "Kontrola pristupa viljuškaru preko PIN koda ili RFID",
    "Nisko težište viljuškara smanjuje rizik od prevrtanja",
    "Linde Curve Assist smanjuje brzinu u krivinama prema uglu upravljanja",
    "Linde Load Assist smanjuje rizik od prevrtanja pri premeštanju tereta na visini",
    "Automatska parkirna kočnica sa funkcijom držanja na uzbrdici"
   ]
  },
  {
   "group": "Servisiranje",
   "icon": "wrench",
   "bullets": [
    "Truck Health Monitoring omogućava sveobuhvatno praćenje kvarova i brže pronalaženje uzroka. Habanje i oštećenja se rano prepoznaju, pa se raspoloživost viljuškara povećava",
    "Aplikacija Linde Ex-Monitoring za brzu i efikasnu dijagnostiku vrednosti važnih za ATEX",
    "Električne ATEX komponente sa sertifikovanim utičnim priključcima mogu se brzo zameniti, što skraćuje zastoj pri popravkama",
    "Ažuriranje firmvera može da se vrši na daljinu, što štedi troškove",
    "Centralna isporuka standardnih i ATEX rezervnih delova 24 sata, 7 dana u nedelji",
    "Gusta servisna mreža sa sertifikovanim tehničarima"
   ]
  }
