 "characteristics": [
  {
   "group": "Bezbednost",
   "icon": "shield",
   "bullets": [
    "Linde Protector Frame za najviši nivo bezbednosti vozača",
    "Posebno uzan profil stuba za najbolju preglednost",
    "Linde Curve Assist smanjuje brzinu u krivinama i rizik da se viljuškar prevrne",
    "Linde Engine Protection System prati važne radne vrednosti motora, kao što su pritisak ulja i nivo i temperatura rashladne tečnosti"
   ]
  },
  {
   "group": "Ergonomija",
   "icon": "seat",
   "bullets": [
    "Prostrana kabina sa mnogo mesta za noge, udobnim sedištem i ambijentom kao u automobilu, za rad bez zamora",
    "Ergonomski raspored svih komandi, sa podesivim naslonom za ruku i sedištem, za efikasan i udoban rad",
    "Precizno i osetljivo upravljanje svim pokretima stuba i podizanja, za lako manevrisanje",
    "Kabina vozača, stub i pogonska osovina odvojeni od šasije, za rad gotovo bez vibracija i udara"
   ]
  },
  {
   "group": "Upravljanje",
   "icon": "lever",
   "bullets": [
    "Hidrostatički direktni pogon za brz, miran i precizan odziv",
    "Izdržljivi motori na dizel, TNG ili prirodni gas daju visok obrtni moment uz malu potrošnju goriva",
    "Upravljanje sa dve pedale ili jednom pedalom, za efikasan rad",
    "Linde Load Control za vrlo precizno upravljanje svim funkcijama stuba"
   ]
  },
  {
   "group": "Servisiranje",
   "icon": "wrench",
   "bullets": [
    "Oslonci osovina i cilindara za naginjanje ne traže održavanje, pa su zastoji i troškovi rada mali",
    "Linde hidrostatička transmisija smanjuje troškove servisa, drži viljuškar spremnim za rad i povećava učinak pretovara",
    "Lak pristup delovima za održavanje, za brz servis i više vremena u radu",
    "Brza dijagnostika preko laptopa"
   ]
  }
 ],
