 "lede": "Čeoni viljuškar na dizel, TNG ili CNG, nosivosti 3.500 do 4.999 kg, u 13 verzija.",
 "characteristics": [
  {
   "group": "Bezbednost",
   "icon": "shield",
   "bullets": [
    "Optimizovan dizajn daje odličnu preglednost u svim smerovima",
    "Krov sa uskim poprečnim nosačima i opcionim krovnim panelom od neprobojnog stakla olakšava rad na velikim visinama podizanja",
    "Nisko težište tereta i visoko postavljena upravljačka osovina poboljšavaju stabilnost viljuškara u krivinama",
    "Linde Curve Assist i Linde Load Assist smanjuju rizik od prevrtanja i nezgoda pri utovaru"
   ]
  },
  {
   "group": "Ergonomija",
   "icon": "seat",
   "bullets": [
    "Ergonomski i intuitivan koncept rukovanja daje vozaču viljuškara najveću udobnost",
    "Komponente odvojene od šasije (osovine, stub i cilindar za naginjanje) štite od udara i vibracija",
    "Širok izbor ergonomskih sedišta sprečava probleme sa držanjem tela",
    "Ekran od 3,5 inča standardno prikazuje ugao upravljanja i nagiba i daje stalan pregled svih važnih podataka"
   ]
  },
  {
   "group": "Upravljanje",
   "icon": "wheel",
   "bullets": [
    "Linde Load Control i upravljanje sa dve pedale obezbeđuju precizno upravljanje svim pokretima vožnje i stuba",
    "Cilindri za naginjanje postavljeni gore obezbeđuju torzionu krutost i veliku preostalu nosivost na velikim visinama podizanja",
    "Mala potrošnja goriva smanjuje troškove rada",
    "Slobodno programabilni tasteri u naslonu za ruku daju pristup često korišćenim funkcijama"
   ]
  },
  {
   "group": "Servisiranje",
   "icon": "wrench",
   "bullets": [
    "Robusna konstrukcija sa delovima koji se malo habaju i ne traže održavanje obezbeđuje veliku raspoloživost",
    "Linde Engine Protection System (LEPS) daje dodatnu zaštitu od oštećenja motora",
    "Veoma veliki servisni otvori olakšavaju održavanje",
    "Standardizovani zavrtanjski spojevi štede mnogo vremena pri održavanju i popravkama"
   ]
  }
 ],
