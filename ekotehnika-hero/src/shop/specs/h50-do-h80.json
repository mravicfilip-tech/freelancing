 "lede": "Čeoni viljuškar na dizel, nosivosti 5.000 do 8.000 kg, u 6 verzija.",
 "characteristics": [
  {
   "group": "Ergonomija",
   "icon": "seat",
   "bullets": [
    "Ergonomski i intuitivan koncept rukovanja daje vozaču viljuškara najveću udobnost",
    "Delovi odvojeni od šasije (osovine, stub i cilindar za naginjanje) štite od udara i vibracija",
    "Širok izbor ergonomskih sedišta sprečava probleme sa držanjem tela",
    "Ekran od 3,5 inča standardno prikazuje ugao upravljanja i nagib stuba i stalno daje pregled svih važnih informacija"
   ]
  },
  {
   "group": "Upravljanje",
   "icon": "lever",
   "bullets": [
    "Snažan i precizan rad zahvaljujući hidrostatičkom prenosu",
    "Brzo i ekološki prihvatljivo rukovanje teretom, zahvaljujući snažnim motorima male potrošnje i niske emisije",
    "Linde Load Control i upravljanje sa dve pedale obezbeđuju precizno upravljanje svim pokretima vožnje i stuba",
    "Odlična preostala nosivost za slaganje teških tereta"
   ]
  },
  {
   "group": "Bezbednost",
   "icon": "shield",
   "bullets": [
    "Linde torziona podrška nudi odličnu stabilnost i 30% manje uvijanja stuba na velikim visinama podizanja",
    "Neprevaziđena bezbednost vozača zahvaljujući Linde Protector Frame i zaštiti krova od tereta koji pada",
    "Linde Curve Assist i Linde Load Assist smanjuju rizik od prevrtanja i nezgoda pri utovaru",
    "Uzak stub sa uklopljenim profilima za optimalnu preglednost na sve strane"
   ]
  },
  {
   "group": "Servisiranje",
   "icon": "wrench",
   "bullets": [
    "Dugi intervali održavanja obezbeđuju najveću raspoloživost i najmanje troškove servisa",
    "Zamena hidrauličnog ulja tek posle 6.000 radnih sati",
    "Linde hidrostatička transmisija uklanja delove koji se habaju i traže mnogo održavanja, kao što su kvačila, menjač i mehaničke kočnice",
    "Ažuriranja softvera i daljinska dijagnostika kvarova omogućavaju preventivno održavanje i skraćuju vreme servisa"
   ]
  }
 ],
