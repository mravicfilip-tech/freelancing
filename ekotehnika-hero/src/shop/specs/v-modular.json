 "characteristics": [
  {
   "group": "Bezbednost",
   "icon": "shield",
   "bullets": [
    "Komande sa nadzorom senzora i prekidač mrtvog čoveka obezbeđuju najveću bezbednost pri vožnji",
    "Električno nadzirane bočne ograde za bezbedan rad sa podignutom kabinom",
    "Optimizovana preglednost stuba omogućava bolji pogled na teret i okolinu viljuškara",
    "Mobilna lična zaštitna oprema (PSE) otkriva ljude ili prepreke na putanji i zaustavlja vozilo u uskom prolazu",
    "Pomoćni sistem Linde System Control izračunava preostalu nosivost i sprečava preopterećenje",
    "Opcione crvene linije upozorenja za bolju preglednost u slabo osvetljenim prolazima i na radnim visinama"
   ]
  },
  {
   "group": "Ergonomija",
   "icon": "seat",
   "bullets": [
    "Širok ulaz u kabinu i mala visina ulaska za lak ulazak u vozilo",
    "Mekana podna prostirka upija vibracije i štiti vozača od fizičkog opterećenja",
    "Prostrana kabina vozača za najveću slobodu kretanja i udoban rad",
    "Patentirani Ergo valjak za rasterećenje mišića",
    "Ergonomski upravljački panel koji se može postaviti na strani stuba, na strani tereta ili na obe strane",
    "Ekran u boji za savršen pregled svih bitnih podataka (vreme, brzina, visina podizanja i drugo)",
    "Opciona ograda protiv nagiba za bezbedno i udobno komisioniranje sa regala"
   ]
  },
  {
   "group": "Performanse",
   "icon": "gauge",
   "bullets": [
    "Visina komisioniranja do 14,5 m (V modular B 7,8 m) za efikasno komisioniranje na vrlo visokim nivoima regala",
    "Najveća brzina od 13 km/h za brzu vožnju",
    "Opcioni tripleks stub bez slobodnog podizanja za veće brzine podizanja",
    "Dve izvedbe vozila, sa platformom na koju se staje ili za komisioniranje iz zatvorene kabine",
    "Redizajnirana šasija i poboljšani krakovi za teret za veću stabilnost i upravljivost",
    "Visoka preostala nosivost za maksimalno rukovanje teretom i na velikim visinama"
   ]
  },
  {
   "group": "Servisiranje",
   "icon": "wrench",
   "bullets": [
    "Elektromotor koji ne traži održavanje, za najveću raspoloživost vozila i niske troškove servisa",
    "Zatvoreni motori za vožnju i podizanje za optimalnu zaštitu od prašine i prljavštine",
    "Lak pristup svim važnim delovima zahvaljujući konstrukciji pogodnoj za servis",
    "CAN bus priključak za lak pristup svim podacima vozila preko dijagnostičkog priključka"
   ]
  }
