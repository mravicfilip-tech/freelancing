  {
   "group": "Bezbednost",
   "icon": "shield",
   "bullets": [
    "Uski profili stuba, prednji stub kabine i krov oblikovani za optimalnu preglednost tereta i okoline",
    "Nisko težište i automatsko smanjenje brzine u krivinama smanjuju rizik od prevrtanja",
    "Automatska parkirna kočnica obezbeđuje bezbedno parkiranje na nagibima",
    "Brojni opcioni sistemi pomoći vozaču, osvetljenja i upozorenja"
   ]
  },
  {
   "group": "Ergonomija",
   "icon": "seat",
   "bullets": [
    "Intuitivan i ergonomski koncept rukovanja smanjuje fizičko opterećenje vozača",
    "Radno mesto vozača odvojeno je od stuba i osovina gumenim ležajevima, što štiti vozača pri intenzivnom radu i na neravnom tlu",
    "Prostrana kabina vozača i izbor ergonomskih sedišta za rad bez zamora",
    "Pregledan ekran od 3,5 inča, optimalno postavljen, za uvid u sve važne podatke o viljuškaru na prvi pogled"
   ]
  },
  {
   "group": "Upravljanje",
   "icon": "lever",
   "bullets": [
    "Dug međuosovinski razmak i gume velikog prečnika daju stabilnost pri rukovanju teretom napolju i na neravnim podlogama",
    "Pogon na prednje točkove sa dva motora i visokoučinskim sinhronim reluktantnim motorima (SRM+) za najveću snagu i upravljivost",
    "Precizno i intuitivno upravljanje svim pokretima vožnje i podizanja preko upravljanja sa dve ili jednom pedalom i Linde Load Control",
    "Konstrukcija stuba otporna na uvijanje i cilindri za naginjanje postavljeni gore daju visoku preostalu nosivost i bezbedno, sigurno rukovanje teretom"
   ]
  },
  {
   "group": "Servisiranje",
   "icon": "wrench",
   "bullets": [
    "Visoka raspoloživost zahvaljujući robusnoj, modularnoj konstrukciji i brojnim delovima koji se malo habaju i ne traže održavanje",
    "Niski troškovi održavanja zahvaljujući dugim servisnim intervalima i lako dostupnim delovima",
    "Daljinska dijagnostika i bežična ažuriranja softvera pomažu preventivnom održavanju i smanjuju opterećenje servisera",
    "Modularni delovi omogućavaju brzu dijagnostiku i brzu zamenu, pa su zastoji kraći"
   ]
  }
