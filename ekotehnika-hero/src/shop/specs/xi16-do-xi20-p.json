 "characteristics": [
  {
   "group": "Ergonomija",
   "icon": "seat",
   "bullets": [
    "Radno mesto vozača izolovano od udara i vibracija sa puta elastomernim prstenastim ležajevima, što smanjuje vibracije i zamor vozača",
