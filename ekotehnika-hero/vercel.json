{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/prodavnica",
      "destination": "/index.html"
    },
    {
      "source": "/prodavnica/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/kontakt",
      "destination": "/index.html"
    },
    {
      "source": "/najam",
      "destination": "/index.html"
    },
    {
      "source": "/servis",
      "destination": "/index.html"
    },
    {
      "source": "/delovi",
      "destination": "/index.html"
    },
    {
      "source": "/kompanija",
      "destination": "/index.html"
    },
    {
      "source": "/linde-safety-guard",
      "destination": "/index.html"
    },
    {
      "source": "/linde-safety-guard/",
      "destination": "/index.html"
    },
    {
      "source": "/postavka-regala-vemax",
      "destination": "/index.html"
    },
    {
      "source": "/postavka-regala-vemax/",
      "destination": "/index.html"
    },
    {
      "source": "/staplercup-2025",
      "destination": "/index.html"
    },
    {
      "source": "/staplercup-2025/",
      "destination": "/index.html"
    },
    {
      "source": "/linde-servisni-setovi",
      "destination": "/index.html"
    },
    {
      "source": "/linde-servisni-setovi/",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  }
}
