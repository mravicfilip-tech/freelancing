{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/prodavnica", "destination": "/index.html" },
    { "source": "/prodavnica/(.*)", "destination": "/index.html" },
    { "source": "/kontakt", "destination": "/index.html" }
  ],
  "git": { "deploymentEnabled": { "claude/*": false } }
}
