+/* ---- the closing section, the delivery photos flow in along the grid ---- */
+.sx-closing {
+  --pad: clamp(40px, 5vh, 60px);
+  --row: clamp(170px, calc((100vh - 140px) / 4), 230px);
+  --c1: var(--x1);
+  --c3: round(nearest, calc(48px + 2 * var(--gx)), 1px);
+  --c5: round(nearest, calc(48px + 4 * var(--gx)), 1px);
+  --c9: round(nearest, calc(48px + 8 * var(--gx)), 1px);
+  --c11: round(nearest, calc(48px + 10 * var(--gx)), 1px);
+  --c13: var(--x5);
+  padding: var(--pad) 0;
+  overflow-x: clip;
+}
+
+.sx-cframe {
+  position: relative;
+  height: calc(var(--row) * 4);
+}
+
+/* the side rules stop at the centre columns, the verticals run the full height and the two outer ones into the padding */
+.sx-hl-l {
+  width: calc(var(--c5) - var(--c1) + 1px);
+}
+
+.sx-hl-r {
+  left: var(--c9);
+  width: calc(var(--c13) - var(--c9) + 1px);
+}
+
+.sx-vl-frame {
+  bottom: -1px;
+}
+
+.sx-vl-ext {
+  top: calc(var(--pad) * -1);
+  bottom: calc(var(--pad) * -1);
+}
+
+.sx-cframe .sx-rule,
+.sx-cframe .sx-vl {
+  z-index: 2;
+}
+
+/* a photo fills one cell, two rows tall, with square corners. --k is the share of its way still to go, set from the scroll, 0 is in
+   place. A left photo starts with its right edge on the left edge of the window, a right photo with its left edge on the right edge. */
+.sx-ph {
+  position: absolute;
+  z-index: 1;
+  height: calc(var(--row) * 2);
+  overflow: hidden;
+  background: var(--grey-pale);
+}
+
+.sx-ph-l {
+  transform: translateX(calc(var(--k, 0) * (-100% - var(--cl))));
+}
+
+.sx-ph-r {
+  transform: translateX(calc(var(--k, 0) * (100cqw - var(--cl))));
+}
+
+.sx-ph img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+/* columns 5 to 8, everything centred */
+.sx-mid {
+  position: absolute;
+  z-index: 4;
+  top: 0;
+  bottom: 0;
+  left: calc(var(--c5) + 2px);
+  width: calc(var(--c9) - var(--c5) - 2px);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 36px 24px 40px;
+  text-align: center;
+}
+
+.sx-mid .sx-label {
+  align-self: auto;
+  justify-content: center;
+}
+
+.sx-ctitle {
+  margin-top: 28px;
+  font-size: clamp(44px, 4.2cqw, 80px);
+  font-weight: 400;
+  line-height: 0.95;
+  letter-spacing: -0.03em;
+}
+
+.sx-clede {
